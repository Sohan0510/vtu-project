# WhatsApp Placement Calendar Bot Configuration

# Target WhatsApp Groups:
# Use '*' to listen to all groups (Discovery Mode)
# Or specify comma-separated group names or JIDs: e.g. "Placement 2027 Test,120363389271@g.us"
ALLOWED_GROUPS=*

# Enable automatic emoji reactions on WhatsApp messages (⏳ processing, 📅 added to calendar, 🔄 updated, 🔁 duplicate)
ENABLE_EMOJI_REACTIONS=true

# Backend Calendar of Events (COE) API URL
API_BASE_URL=https://fast-student-api.vercel.app

# Google Gemini API Key (already loaded automatically from parent .env if present)
# GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Run in DRY_RUN mode (logs actions without changing the database)
DRY_RUN=false
