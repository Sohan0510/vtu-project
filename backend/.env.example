# Server Port
PORT=5000

# MongoDB Configuration
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=vtu_database

# Admin Authentication
ADMIN_ID=admin
# Generate using: node scripts/generate-hash.js <your_password>
ADMIN_PW_HASH=
# A long random secret string to sign and verify JWT tokens
JWT_SECRET=your_jwt_secret_key_change_in_production

# Gemini AI (for placement notice parsing)
GEMINI_API_KEY=your_gemini_api_key

# Google Calendar Service Account (Optional for Google Calendar sync)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID=your_calendar_id@group.calendar.google.com
