# Vite Frontend Environment Variables
# In Vite, variables exposed to the client bundle must be prefixed with VITE_

# Base API URL (Leave blank to use relative paths e.g. '/api' through Vite/Nginx proxy, or set your custom backend URL)
VITE_API_BASE_URL=

# Google OAuth 2.0 Web Client ID
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# ----------------- GOOGLE SPREADSHEETS & DRIVE LINKS -----------------

# 1. Blacklisted / Debarred Students Registry Spreadsheet
VITE_SHEET_BLACKLISTED_URL=https://docs.google.com/spreadsheets/
# 2. Central Placement Data Google Drive Folder
VITE_DRIVE_PLACEMENT_URL=https://drive.google.com/drive/
# 3. Students Database Master Spreadsheet
VITE_SHEET_STUDENTS_DB_URL=https://docs.google.com/spreadsheets/d/your_students_db_sheet_id/edit?usp=sharing

# 4. Placed Data (Direct Open Link)
VITE_SHEET_PLACED_DATA_URL=https://docs.google.com/spreadsheets/d/your_placed_data_sheet_id/edit?usp=sharing

# 5. Placed Data (Embedded iframe Link)
VITE_SHEET_PLACED_DATA_EMBED_URL=https://docs.google.com/spreadsheets/d/your_placed_data_sheet_id/htmlembed?widget=true&headers=false
